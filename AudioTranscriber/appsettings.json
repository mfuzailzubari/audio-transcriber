{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=audiotranscriber.db"
  },
  "Storage": {
    "RootPath": "uploads"
  },
  "Upload": {
    "MaxFileSizeMb": 200,
    "AllowedExtensions": [ ".wav", ".mp3", ".m4a", ".flac", ".ogg", ".webm" ]
  }
}
